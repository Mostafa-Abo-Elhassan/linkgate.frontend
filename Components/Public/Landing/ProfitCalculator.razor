<section id="calculator" class="profit-calculator-section">
    <div class="container">

        <div class="profit-header text-center">

            <span class="profit-eyebrow">
                Profit Calculator
            </span>

            <h2>
                احسب أرباحك المتوقعة
            </h2>

            <p>
                اعرف القيمة التقريبية لعائد حسابك بناءً على
                عمر الحساب وعدد الـ Connections.
            </p>

        </div>

        <div class="profit-card">

            <div class="row g-0">

                <!-- Calculator Form -->
                <div class="col-lg-7">

                    <div class="profit-form">

                        <div class="profit-form-heading">

                            <div class="profit-step">
                                01
                            </div>

                            <div>
                                <h3>بيانات الحساب</h3>

                                <p>
                                    أدخل بيانات حسابك للحصول على تقدير الأرباح.
                                </p>
                            </div>

                        </div>


                        <!-- Account Age -->

                        <div class="profit-field">

                            <label class="form-label">
                                سنة إنشاء الحساب
                            </label>

                            <select class="form-select">
                                <option value="">اختر السنة</option>
                                <option>2026</option>
                                <option>2025</option>
                                <option>2024</option>
                                <option>2023</option>
                                <option>2022</option>
                                <option>2021</option>
                                <option>2020</option>
                            </select>

                        </div>


                        <!-- Connections -->

                        <div class="profit-field">

                            <div class="profit-label-row">

                                <label class="form-label mb-0">
                                    عدد الـ Connections
                                </label>

                                <span class="connection-value">
                                    500
                                </span>

                            </div>

                            <input type="range"
                                   class="form-range profit-range"
                                   min="100"
                                   max="5000"
                                   step="100"
                                   value="500" />

                            <div class="range-labels">
                                <span>100</span>
                                <span>5,000+</span>
                            </div>

                        </div>


                        <button class="btn btn-primary profit-submit">
                            احسب أرباحي

                            <span class="profit-submit-arrow">
                                →
                            </span>
                        </button>

                    </div>

                </div>


                <!-- Result -->
                <div class="col-lg-5">

                    <div class="profit-result">

                        <div class="profit-result-glow"></div>

                        <div class="profit-result-content">

                            <span class="result-caption">
                                الأرباح المتوقعة شهرياً
                            </span>

                            <div class="result-value">

                                <span>
                                    8,500
                                </span>

                                <small>
                                    ج.م
                                </small>

                            </div>

                            <p>
                                تقدير مبدئي بناءً على بيانات الحساب
                                المدخلة.
                            </p>


                            <div class="result-divider"></div>


                            <div class="result-info">

                                <div>
                                    <span>
                                        عمر الحساب
                                    </span>

                                    <strong>
                                        4+ سنوات
                                    </strong>
                                </div>

                                <div>
                                    <span>
                                        Connections
                                    </span>

                                    <strong>
                                        500+
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>