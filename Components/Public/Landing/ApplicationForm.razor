<section id="application"
         class="application-section py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="text-center mb-5">

                    <span class="badge bg-light text-primary mb-3">
                        Get Started
                    </span>

                    <h2 class="fw-semibold">
                        قدم طلبك الآن
                    </h2>

                    <p class="text-muted">
                        املأ البيانات التالية لإرسال طلبك للمراجعة.
                    </p>

                </div>

                <div class="card">

                    <div class="card-body p-4 p-lg-5">

                        <div class="row g-4">

                            <div class="col-md-6">
                                <label class="form-label">
                                    الاسم الكامل
                                </label>

                                <input class="form-control"
                                       placeholder="الاسم الكامل" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    رقم الهاتف
                                </label>

                                <input class="form-control"
                                       placeholder="رقم الهاتف" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    البريد الإلكتروني
                                </label>

                                <input type="email"
                                       class="form-control"
                                       placeholder="example@email.com" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    LinkedIn URL
                                </label>

                                <input class="form-control"
                                       placeholder="https://linkedin.com/in/..." />
                            </div>

                            <div class="col-12">
                                <label class="form-label">
                                    صورة عدد الـ Connections
                                </label>

                                <input type="file"
                                       class="form-control" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">
                                    صورة عمر الحساب
                                </label>

                                <input type="file"
                                       class="form-control" />
                            </div>

                            <div class="col-12">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="terms" />

                                    <label class="form-check-label"
                                           for="terms">
                                        أوافق على الشروط والسياسات.
                                    </label>

                                </div>

                            </div>

                            <div class="col-12">

                                <button class="btn btn-primary w-100">
                                    تقديم الطلب
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>