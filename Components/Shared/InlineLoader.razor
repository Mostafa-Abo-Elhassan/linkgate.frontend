@* Shared/InlineLoader.razor

@if (IsVisible)
{
    <div class="inline-upload-loader">
        <div class="inline-spinner"></div>
        <span>@Text</span>
    </div>
}

<style>
    .inline-upload-loader {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
        padding: 4px 8px;
        background: #F9FAFB;
        border: 1px solid #E5E7EB;
        border-radius: 6px;
        width: fit-content;
    }

        .inline-upload-loader span {
            font-size: 11px;
            color: #4B5563;
            font-weight: 500;
            font-family: system-ui, -apple-system, sans-serif;
        }

    .inline-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid #E5E7EB;
        border-top: 2px solid #0077B5;
        border-radius: 50%;
        animation: spin-field 0.8s linear infinite;
    }

    @@keyframes spin-field {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    [Parameter] public bool IsVisible { get; set; } = false;
    [Parameter] public string Text { get; set; } = "جاري المعالجة...";
} *@




