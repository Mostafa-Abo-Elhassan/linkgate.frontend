@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="public-layout">

    <header class="public-navbar">
        <nav class="navbar">
            <div class="container">

                <div class="navbar-main">

                    <a class="navbar-brand"
                       href="/">
                        LinkGate
                    </a>

                    <button class="navbar-toggle"
                            type="button"
                            aria-label="Toggle navigation"
                            aria-expanded="false"
                            onclick="publicNavbar.toggle()">

                        <span></span>
                        <span></span>
                        <span></span>

                    </button>

                </div>

                <div class="navbar-menu"
                     id="publicNavbar">

                    <ul class="navbar-nav">

                        <li>
                            <a class="nav-link" href="#calculator">
                                حاسبة الأرباح
                            </a>
                        </li>

                        <li>
                            <a class="nav-link" href="#how-it-works">
                                كيف يعمل؟
                            </a>
                        </li>

                        <li>
                            <a class="nav-link" href="#faq">
                                الأسئلة الشائعة
                            </a>
                        </li>

                    </ul>

                    <div class="navbar-actions">

                        <button class="btn btn-secondary"
                                @onclick="ToggleTheme">
                            @(isDark ? "Light Mode" : "Dark Mode")
                        </button>

                        @* Language *@
                        @* 
                    <button class="btn btn-secondary"
                            @onclick="ToggleLanguage">
                        @(isArabic ? "English" : "العربية")
                    </button>
                    *@

                        <a href="#application"
                           class="btn btn-primary">
                            ابدأ الآن
                        </a>

                    </div>

                </div>

            </div>
        </nav>
    </header>

    <main>
        @Body
    </main>

    <footer class="public-footer border-top">
        <div class="container py-5">

            <div class="row g-4">

                <div class="col-lg-6">
                    <h5 class="fw-semibold mb-2">
                        LinkGate
                    </h5>

                    <p class="text-muted mb-0">
                        منصة لإدارة وتشغيل حسابات LinkedIn
                        من خلال نظام مؤتمت ومنظم.
                    </p>
                </div>

                <div class="col-6 col-lg-3">
                    <h6 class="fw-semibold">
                        روابط
                    </h6>

                    <div class="d-flex flex-column gap-2">
                        <a href="/referral">برنامج الإحالة</a>
                        <a href="/how-it-works">كيف يعمل؟</a>
                        <a href="/policies">الشروط والسياسات</a>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <h6 class="fw-semibold">
                        تواصل
                    </h6>

                    <a href="/contact">
                        تواصل معنا
                    </a>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-md-row
                justify-content-between gap-2">

                <small class="text-muted">
                    © @DateTime.Now.Year LinkGate
                </small>

                <small class="text-muted">
                    جميع الحقوق محفوظة
                </small>

            </div>

        </div>
    </footer>

</div>

                    
@code {
    private bool isDark;

    private async Task ToggleTheme()
    {
        isDark = await JS.InvokeAsync<bool>("themeManager.toggle");
    }


    // private bool isArabic = true;

    // private async Task ToggleLanguage()
    // {
    //     isArabic = !isArabic;

    //     await JS.InvokeVoidAsync(
    //         "languageManager.setLanguage",
    //         isArabic ? "ar" : "en");
    // }
}