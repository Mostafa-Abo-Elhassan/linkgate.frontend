@page "/admin/dashboard"
@layout AdminLayout


<div class="dashboard-page">
    <div class="mb-4">
        <h2 class="h5 fw-bold text-dark mb-1">Admin Dashboard</h2>
        <p class="text-muted small">Welcome back, here is a quick overview of the system activities.</p>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card border border-light bg-white p-3 rounded-2 shadow-sm">
                <span class="text-muted small">System Status</span>
                <h5 class="text-success fw-bold mt-2 mb-0">● Operational</h5>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border border-light bg-white p-3 rounded-2 shadow-sm">
                <span class="text-muted small">Active Domain</span>
                <h5 class="text-dark fw-bold mt-2 mb-0">Application & Onboarding</h5>
            </div>
        </div>
    </div>
</div>