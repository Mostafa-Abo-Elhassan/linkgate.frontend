@page "/admin/applications/{Id:guid}"
@layout AdminLayout

@using LinkGate.frontend.Models.Applications.Responses
@using LinkGate.frontend.Services.Applications
@inject ApplicationService AppService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="saas-page-container position-relative">
    <!-- Header -->
    <button class="btn-back mb-4" @onclick="GoBack">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Applications
    </button>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner"></div>
            <p class="text-muted small mt-3">Loading details...</p>
        </div>
    }
    else if (app == null)
    {
        <div class="empty-state">
            <h4 class="empty-title">Application Not Found</h4>
            <p class="empty-desc">The application you are looking for does not exist.</p>
        </div>
    }
    else
    {
        <div class="details-header mb-4 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="page-title">@app.FullName</h2>
                <p class="text-muted small mb-0">Application ID: @app.Id</p>
            </div>
            <span class="status-badge @GetStatusClass(app.Status)">@app.StatusName</span>
        </div>

        <div class="row g-4">

            <!-- Applicant Information Section -->
            <div class="col-xl-4 col-lg-5">
                <div class="saas-card h-100 d-flex flex-column">
                    <h5 class="card-title">Applicant Information</h5>
                    <div class="info-list flex-grow-1">

                        <div class="info-group">
                            <span class="info-label">Name</span>
                            <span class="info-value fw-medium text-dark">@app.FullName</span>
                        </div>

                        <!-- Phone with Actions -->
                        <div class="info-group">
                            <span class="info-label">Phone Number</span>
                            <div class="quick-action-cell">
                                <span class="info-value">@app.PhoneNumber</span>
                                <div class="action-icons">
                                    <a href="https://wa.me/@FormatWhatsAppNumber(app.PhoneNumber)" target="_blank" class="mini-icon wa-icon" title="WhatsApp">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                    </a>
                                    <button @onclick="() => CopyToClipboard(app.PhoneNumber)" class="mini-icon copy-icon" title="Copy">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Email with Actions -->
                        <div class="info-group">
                            <span class="info-label">Email Address</span>
                            <div class="quick-action-cell">
                                <span class="info-value" style="word-break: break-all;">@app.Email</span>
                                <div class="action-icons">
                                    <a href="mailto:@app.Email" class="mini-icon email-icon" title="Send Email">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                    </a>
                                    <button @onclick="() => CopyToClipboard(app.Email)" class="mini-icon copy-icon" title="Copy">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions Panel (Only if Pending) -->
                    @if (app.Status == 1) // 1 = Pending
                    {
                        <!-- باقي كود الأزرار Approve و Reject -->
                        <div class="actions-panel mt-4 pt-4 border-top">
                            <p class="small text-muted mb-3">Review Application</p>
                            <div class="d-flex gap-2 mt-2">
                                <button class="btn-approve" @onclick="ShowApproveDialog">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    Approve
                                </button>
                                <button class="btn-reject" @onclick="ShowRejectDialog">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                    Reject
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- LinkedIn Information Section -->
            <div class="col-xl-8 col-lg-7">
                <div class="saas-card h-100">
                    <h5 class="card-title">LinkedIn Information</h5>

                    <div class="row g-4 mb-4">
                        <div class="col-sm-6 info-group">
                            <span class="info-label">LinkedIn Profile</span>
                            <a href="@app.LinkedInUrl" target="_blank" class="info-value linkedin-link d-inline-block text-truncate w-100">@app.LinkedInUrl</a>
                        </div>
                        <div class="col-sm-6 info-group">
                            <span class="info-label">Account Age</span>
                            <span class="info-value">@(app.AccountAgeYears) Years, @(app.AccountAgeMonths) Months</span>
                        </div>
                        <div class="col-sm-6 info-group">
                            <span class="info-label">Number of Connections</span>
                            <span class="info-value fw-bold">@app.NumberOfConnections</span>
                        </div>
                        <div class="col-sm-6 info-group">
                            <span class="info-label">Creation Date</span>
                            <span class="info-value">@app.LinkedInAccountCreationDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>

                    <!-- Images Preview -->
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <span class="info-label mb-2 d-block">Connections Screenshot</span>
                            <div class="image-preview-container" @onclick='() => OpenImagePreview(app.NumberOfConnectionsScreenshotUrl)'>
                                <img src="@app.NumberOfConnectionsScreenshotUrl" alt="Connections Screenshot" class="preview-img" />
                                <div class="image-overlay"><span>View Full Size</span></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <span class="info-label mb-2 d-block">Account Creation Screenshot</span>
                            <div class="image-preview-container" @onclick='() => OpenImagePreview(app.AccountCreationDateScreenshotUrl)'>
                                <img src="@app.AccountCreationDateScreenshotUrl" alt="Account Creation Screenshot" class="preview-img" />
                                <div class="image-overlay"><span>View Full Size</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Meta Data -->
                    <div class="meta-data mt-4 pt-4 border-top">
                        <div class="row g-3 small">
                            <div class="col-sm-4 text-muted"><strong>Created At:</strong> <br />@app.CreatedAt.ToString("g")</div>
                            <div class="col-sm-4 text-muted"><strong>Reviewed At:</strong> <br />@(app.ReviewedAt?.ToString("g") ?? "Not reviewed yet")</div>
                            <div class="col-sm-4 text-muted"><strong>Referral Code:</strong> <br />@(string.IsNullOrEmpty(app.ReferralCode) ? "-" : app.ReferralCode)</div>
                            <div class="col-12 text-muted"><strong>User Notes:</strong> <br />@(string.IsNullOrEmpty(app.Notes) ? "None" : app.Notes)</div>
                            @if (!string.IsNullOrEmpty(app.AdminNote))
                            {
                                <div class="col-12 text-muted"><strong>Admin Note:</strong> <br />@app.AdminNote</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ================== MODALS ================== -->
    <!-- Image Preview Modal -->
    @if (showImageModal)
    {
        <div class="saas-modal-backdrop" @onclick="CloseImagePreview">
            <div class="saas-image-modal" @onclick:stopPropagation>
                <button class="modal-close-btn" @onclick="CloseImagePreview">✕</button>
                <img src="@currentPreviewImage" class="full-size-img" alt="Full Size Preview" />
            </div>
        </div>
    }

    <!-- Approve Dialog Modal -->
    @if (showApproveModal)
    {
        <div class="saas-modal-backdrop">
            <div class="saas-dialog">
                <h4 class="dialog-title">Approve Application</h4>
                <p class="dialog-desc">Are you sure you want to approve this application? An approval email will be triggered automatically.</p>
                <div class="dialog-actions">
                    <button class="btn-cancel" @onclick="CloseModals" disabled="@isProcessing">Cancel</button>
                    <button class="btn-approve" @onclick="ConfirmApprove" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-small"></span>
                        }
                        else
                        {

                            <span>Confirm Approve</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Reject Dialog Modal -->
    @if (showRejectModal)
    {
        <div class="saas-modal-backdrop">
            <div class="saas-dialog">
                <h4 class="dialog-title">Reject Application</h4>
                <p class="dialog-desc">Are you sure you want to reject this application? You can provide an optional reason.</p>
                <textarea class="saas-textarea mb-4" rows="3" placeholder="Enter rejection reason (optional)..." @bind="rejectionReason" disabled="@isProcessing"></textarea>
                <div class="dialog-actions">
                    <button class="btn-cancel" @onclick="CloseModals" disabled="@isProcessing">Cancel</button>
                    <button class="btn-reject" @onclick="ConfirmReject" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-small"></span>
                        }
                        else
                        {

                            <span>Confirm Reject</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ================== TOAST NOTIFICATION ================== -->
    @if (showToast)
    {
        <div class="saas-toast @(toastIsSuccess ? "toast-success" : "toast-error")">
            <svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                @if (toastIsSuccess)
                {
                    <polyline points="20 6 9 17 4 12"></polyline>
                }
                else
                {
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                }
            </svg>
            <span>@toastMessage</span>
        </div>
    }

</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ApplicationDetailsResponse? app;
    private bool isLoading = true;
    private bool isProcessing = false;

    // Modals State
    private bool showImageModal = false;
    private string currentPreviewImage = "";

    private bool showApproveModal = false;

    private bool showRejectModal = false;
    private string rejectionReason = "";

    // Toast State
    private bool showToast = false;
    private string toastMessage = "";
    private bool toastIsSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        app = await AppService.GetApplicationDetailsAsync(Id);
        isLoading = false;
    }

    private void GoBack() => Navigation.NavigateTo("/admin/applications");

    // --- Image Preview Logic ---
    private void OpenImagePreview(string url)
    {
        if (string.IsNullOrEmpty(url)) return;
        currentPreviewImage = url;
        showImageModal = true;
    }
    private void CloseImagePreview() => showImageModal = false;

    // --- Approve Logic ---
    private void ShowApproveDialog() => showApproveModal = true;

    private async Task ConfirmApprove()
    {
        isProcessing = true;
        var result = await AppService.ApproveApplicationAsync(Id);
        isProcessing = false;

        CloseModals();

        if (result != null)
        {
            app!.Status = 2; // Approved
            app.ReviewedAt = DateTime.Now;

            string msg = result.EmailSent
                            ? "Approval application successfully and email Approval sent"
                            : "Approval application successfully and email Approval not sent";

            await ShowToastAsync(msg, true);
        }
        else
        {
            await ShowToastAsync("Failed to approve application. Please try again.", false);
        }
    }

    // --- Reject Logic ---
    private void ShowRejectDialog()
    {
        rejectionReason = "";
        showRejectModal = true;
    }

    private async Task ConfirmReject()
    {
        isProcessing = true;
        var result = await AppService.RejectApplicationAsync(Id, rejectionReason);
        isProcessing = false;

        CloseModals();

        if (result != null)
        {
            app!.Status = 3; // Rejected
            app.ReviewedAt = DateTime.Now;
            app.AdminNote = rejectionReason;

            string msg = result.EmailSent
                            ? "Rejection application successfully and email Rejection sent"
                            : "Rejection application successfully and email Rejection not sent";

            await ShowToastAsync(msg, true);
        }
        else
        {
            await ShowToastAsync("Failed to reject application. Please try again.", false);
        }
    }

    private void CloseModals()
    {
        showApproveModal = false;
        showRejectModal = false;
    }

    // --- Helper Functions ---
    private async Task ShowToastAsync(string message, bool isSuccess)
    {
        toastMessage = message;
        toastIsSuccess = isSuccess;
        showToast = true;
        StateHasChanged();

        await Task.Delay(3000);

        showToast = false;
        StateHasChanged();
    }

    private string FormatWhatsAppNumber(string number) => number.Replace("+", "").Replace(" ", "").Trim();

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await ShowToastAsync("Copied to clipboard", true);
    }

    private string GetStatusClass(int status) => status switch
    {
        2 => "badge-success", // Approved
        3 => "badge-danger",  // Rejected
        _ => "badge-warning"  // Pending (1)
    };
}