

@* @page "/admin/applications/{Id:guid}"



@inject ApplicationService AppService
@inject NavigationManager Navigation

<div class="container-fluid py-4" style="max-width: 1200px;">
    <button class="btn btn-sm btn-light border mb-3 text-secondary" @onclick="() => Navigation.NavigateTo('/admin/applications')">← Back to List</button>

    @if (app == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="card border border-light shadow-sm bg-white p-4 rounded-3">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                <h4 class="fw-bold text-dark mb-0">Application Review: @app.FullName</h4>
                <span class="badge @(app.Status == "Approved" ? "bg-success" : app.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">@app.Status</span>
            </div>

            <div class="row g-3 small text-dark">
                <div class="col-md-6"><strong>Email:</strong> @app.Email</div>
                <div class="col-md-6"><strong>Phone Number:</strong> @app.PhoneNumber</div>
                <div class="col-md-6"><strong>LinkedIn URL:</strong> <a href="@app.LinkedInProfileUrl" target="_blank">Profile Link</a></div>
                <div class="col-md-6"><strong>Connections:</strong> @app.NumberOfConnections</div>
                <div class="col-md-6"><strong>Creation Date:</strong> @app.LinkedInAccountCreationDate.ToShortDateString()</div>
                <div class="col-md-6"><strong>Notes:</strong> @(string.IsNullOrEmpty(app.Notes) ? "None" : app.Notes)</div>
            </div>

            <div class="row mt-4 g-3">
                <div class="col-md-6">
                    <p class="small fw-medium text-muted mb-1">Connections Screenshot</p>
                    @if (!string.IsNullOrEmpty(app.NumberOfConnectionsScreenshotUrl))
                    {
                        <img src="@app.NumberOfConnectionsScreenshotUrl" class="img-fluid border rounded" style="max-height: 200px;" />
                    }
                </div>
                <div class="col-md-6">
                    <p class="small fw-medium text-muted mb-1">Creation Date Screenshot</p>
                    @if (!string.IsNullOrEmpty(app.AccountCreationDateScreenshotUrl))
                    {
                        <img src="@app.AccountCreationDateScreenshotUrl" class="img-fluid border rounded" style="max-height: 200px;" />
                    }
                </div>
            </div>

            @if (app.Status == "Pending")
            {
                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button class="btn btn-success btn-sm px-4" @onclick="Approve">Approve Application</button>
                    <button class="btn btn-danger btn-sm px-4" @onclick="Reject">Reject Application</button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private ApplicationDto? app;

    protected override async Task OnInitializedAsync()
    {
        app = await AppService.GetApplicationDetailsAsync(Id);
    }

    private async Task Approve()
    {
        var success = await AppService.ApproveApplicationAsync(Id);
        if (success) app!.Status = "Approved";
    }

    private async Task Reject()
    {
        var success = await AppService.RejectApplicationAsync(Id, "Does not meet criteria");
        if (success) app!.Status = "Rejected";
    }
} *@