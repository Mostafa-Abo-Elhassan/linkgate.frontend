@page "/login"
@layout AuthLayout

<PageTitle>تسجيل الدخول - LinkGate</PageTitle>

<div class="login-card animate-fade-up">
    <div class="text-center mb-4">
        <h1 class="h4 fw-bold mb-2">أهلاً بيك من تاني 👋</h1>
        <p class="text-muted" style="font-size: 15px;">سجل دخول عشان تتابع حساباتك وأرباحك.</p>
    </div>

    <!-- EditForm for Validation -->
    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">

        <div class="mb-4">
            <label class="form-label">البريد الإلكتروني</label>
            <InputText @bind-Value="loginModel.Email" class="form-control form-control-lg" placeholder="name@example.com" />
        </div>

        <div class="mb-4">
            <!-- Label & Forget Password Link in the same row -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">كلمة المرور</label>
                <a href="/forgot-password" class="text-primary text-decoration-none small fw-medium">نسيت الباسورد؟</a>
            </div>
            <InputText @bind-Value="loginModel.Password" type="password" class="form-control form-control-lg" placeholder="••••••••" />
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100 mb-4">تسجيل الدخول</button>

        <div class="text-center">
            <span class="text-muted small">معندكش حساب؟</span>
            <a href="https://localhost:44315/#application" class="text-primary fw-bold text-decoration-none ms-1 small">ابدأ معانا دلوقتي</a>
        </div>
    </EditForm>
</div>

@code {
    private LoginModel loginModel = new();

    private void HandleLogin()
    {
        // هيتم إضافة كود الـ API هنا لاحقاً
        Console.WriteLine($"Logging in with {loginModel.Email}");
    }

    public class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}