@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<div class="saas-not-found-wrapper">
    <div class="not-found-card">

        <!-- Subtle Premium Icon -->
        <div class="icon-container">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>

        <!-- Error Typography -->
        <h1 class="error-code">404</h1>
        <h2 class="error-title">الصفحة غير موجودة</h2>
        <p class="error-desc">
            الصفحة التي تبحث عنها غير موجودة، أو تم نقلها، أو أنك لا تملك الصلاحيات لعرضها.
        </p>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <button class="btn-primary" @onclick="GoHome">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                العودة إلى لوحة التحكم
            </button>
        </div>

    </div>
</div>

@code {
    private void GoHome()
    {
        // يوجه المستخدم للصفحة الرئيسية أو لوحة التحكم
        Navigation.NavigateTo("/");
    }
}